  "dependencies": {
    "@google/genai": "^1.0.0",
    "axios": "^1.16.1",
    "googleapis": "^144.0.0",
    "pg": "^8.21.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/pg": "^8.20.0",
