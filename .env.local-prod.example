# Omon Dashboard local-prod backend environment template
# Copy to .env.local-prod for local production simulation against Supabase.
# Never commit real .env.local-prod files or secrets.

APP_ENV=local-prod
ENV_PROFILE=local-prod
DB_TARGET=supabase
BACKEND_PORT=8001
PORT=8001

# Database: Supabase
DATABASE_URL=postgresql://postgres:replace_with_supabase_password@db.replace_project_ref.supabase.co:5432/postgres
DATABASE_MIGRATION_URL=postgresql://postgres:replace_with_supabase_password@db.replace_project_ref.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=
SUPABASE_MIGRATION_DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Local production simulation auth
DASHBOARD_USERNAME=prod_local_admin@example.com
DASHBOARD_PASSWORD=replace_with_prod_local_password
DASHBOARD_AUTH_TOKEN=replace_with_prod_local_random_token
JWT_SECRET=replace_with_prod_local_jwt_secret
JWT_EXPIRES_IN_MINUTES=10080
TOKEN_ENCRYPTION_SECRET=replace_with_prod_local_token_secret
TOKEN_ENCRYPTION_KEY=replace_with_prod_local_fernet_key
SUPER_ADMIN_EMAILS=prod_local_admin@example.com

# Backend runtime
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://127.0.0.1:5174
FRONTEND_AUTH_REDIRECT_URL=http://127.0.0.1:5174/auth/google/callback
IMPORT_TEMP_DIR=backend/output/imports/temp/local-prod
USE_MOCK_DATA=false

# Google OAuth / Sheets
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=replace_with_prod_local_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_prod_local_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/google/oauth/callback
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_SHEET_ID=replace_with_prod_local_google_sheet_id
MAX_GOOGLE_SHEET_SOURCES=5
GOOGLE_SHEET_REGISTRY_JSON={}

# Rule-based classification
AI_CLASSIFICATION_ENABLED=false
AI_PROVIDER=rule_based
AI_MODEL=none
AI_ONLY_LOW_CONFIDENCE=true
AI_CONFIDENCE_THRESHOLD=0.75
AI_MAX_TRANSACTIONS_PER_RUN=500

# Insight defaults
INSIGHT_NEED_WARNING_RATIO=0.80
INSIGHT_NEED_DANGER_RATIO=0.90
INSIGHT_WANT_WARNING_RATIO=0.30
INSIGHT_WANT_DANGER_RATIO=0.45
INSIGHT_SAVING_WARNING_RATIO=0.10
INSIGHT_SAVING_GOOD_RATIO=0.20
INSIGHT_UNCATEGORIZED_WARNING_COUNT=1
INSIGHT_UNCATEGORIZED_DANGER_COUNT=20
INSIGHT_ANOMALY_WARNING_MULTIPLIER=2.0
INSIGHT_ANOMALY_DANGER_MULTIPLIER=3.0

# Optional local-prod seed values. Do not seed Supabase unless an explicit
# guarded seed/reset workflow asks for confirmation.
SEED_USER_EMAIL=prod_local_admin@example.com
SEED_USER_NAME=Local Prod Admin
SEED_WORKSPACE_NAME=Local Prod Household
