# Dashboard frontend environment template
# Copy to apps/web/.env for local dashboard development.

# Backend API base URL. Keep both names for current app compatibility.
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Replit single-app staging can use same-origin mode instead of external API URL.
# VITE_API_MODE=same-origin

# Guest/demo privacy multiplier used by the dashboard UI.
VITE_GUEST_MODE_MULTIPLIER=0.75
