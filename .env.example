# finance-dashboard local environment template
# Copy this file to .env for local development. Replace every placeholder before
# deploying. Never commit real secrets, spreadsheet IDs, API keys, or passwords.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Runtime app connection used by FastAPI and current Node database scripts.
DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/finance_dashboard
# Optional direct/session connection for migration runners. Leave blank unless
# your provider requires a different URL for schema changes.
DATABASE_MIGRATION_URL=
# Use true for hosted Supabase/PostgreSQL. Local PostgreSQL can use false.
DATABASE_SSL=false
# Keep true when the server certificate can be verified. Set false only when
# your local/proxy SSL setup requires relaxed verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

DASHBOARD_USERNAME=local_admin@example.com
DASHBOARD_PASSWORD=replace_with_local_password
DASHBOARD_AUTH_TOKEN=replace_with_long_random_token
JWT_SECRET=replace_with_long_random_jwt_secret
JWT_EXPIRES_IN_MINUTES=10080
TOKEN_ENCRYPTION_SECRET=replace_with_long_random_token_secret
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key_generated_by_Fernet_generate_key
SUPER_ADMIN_EMAILS=local_admin@example.com

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USE_MOCK_DATA=false

# Google Sheets used by the backend. Use fake IDs here and replace locally.
GOOGLE_SHEET_ID=replace_with_google_sheet_id
MAX_GOOGLE_SHEET_SOURCES=5
GOOGLE_SHEET_REGISTRY_JSON={"2026":{"id":"replace_with_google_sheet_id_2026","name":"Laporan Keuangan 2026"}}

# Gemini classification used by backend sync/classification scripts.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_CLASSIFICATION_MODEL=gemini-2.0-flash
GEMINI_CLASSIFICATION_BATCH_SIZE=25

# Service account mode is only for local development, internal demos, or
# controlled testing. Prefer one option at a time, and never commit real JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_with_project_id","private_key":"replace_with_private_key","client_email":"replace_with_service_account_email","token_uri":"https://oauth2.googleapis.com/token"}
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace_with_base64_encoded_service_account_json
# GOOGLE_APPLICATION_CREDENTIALS=backend/scripts/credentials.local.json

# OAuth is the target production onboarding mechanism for user-owned Google
# Sheets access. Configure these in production instead of sharing service
# account credentials with users.
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/google/oauth/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/spreadsheets.readonly
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/google/callback

SEED_USER_EMAIL=demo.finance@example.com
SEED_USER_NAME=Demo Finance User
SEED_WORKSPACE_NAME=Demo Household

# ---------------------------------------------------------------------------
# Dashboard frontend: apps/web
# ---------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GUEST_MODE_MULTIPLIER=0.75

# ---------------------------------------------------------------------------
# Landing page frontend: apps/landing
# ---------------------------------------------------------------------------
VITE_DASHBOARD_URL=http://127.0.0.1:5173
