DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/google/callback
JWT_SECRET=change_this_to_a_long_random_jwt_secret
JWT_EXPIRES_IN_MINUTES=10080
TOKEN_ENCRYPTION_SECRET=change_this_to_a_different_long_random_token_secret

SEED_USER_EMAIL=demo.finance@example.com
SEED_USER_NAME=Demo Finance User
SEED_WORKSPACE_NAME=Demo Household

GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_REGISTRY_JSON={"2025":{"id":"ID_SPREADSHEET_2025","name":"Laporan Keuangan 2025"},"2026":{"id":"ID_SPREADSHEET_2026","name":"Laporan Keuangan 2026"},"2027":{"id":"ID_SPREADSHEET_2027","name":"Laporan Keuangan 2027"}}
DASHBOARD_USERNAME=your_username
DASHBOARD_PASSWORD=your_password
DASHBOARD_AUTH_TOKEN=change_this_to_a_long_random_token
CORS_ALLOWED_ORIGINS=https://finance-dashboard-mu-lac.vercel.app,http://localhost:5173,http://127.0.0.1:5173
USE_MOCK_DATA=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CLASSIFICATION_MODEL=gemini-2.0-flash
GEMINI_CLASSIFICATION_BATCH_SIZE=25
# Optional for production if backend/output is not deployed.
# FINANCIAL_CLASSIFICATION_JSON_BASE64=base64_encoded_financial_classification_reference_json

# Use one of these credential options. Do not leave a placeholder enabled.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json
# GOOGLE_APPLICATION_CREDENTIALS=backend/scripts/credentials.json
